{
  "tabWidth": 2,
  "endOfLine": "auto",
  "useTabs": false,
  "singleQuote": false,
  "plugins": [
    "@trivago/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ],
  "importOrder": [
    "<THIRD_PARTY_MODULES>",
    "^@\\/app(\\/.*)?$",
    "^@\\/_pages(\\/.*)?$",
    "^@\\/widgets(\\/.*)?$",
    "^@\\/features(\\/.*)?$",
    "^@\\/entities(\\/.*)?$",
    "^@\\/shared(\\/.*)?$",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderParserPlugins": ["typescript", "jsx", "tsx", "decorators-legacy"],
  "importOrderSortSpecifiers": true
}
